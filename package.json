{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "audit:connections": "node scripts/audit-connections.mjs",
    "audit:connections:live": "node scripts/audit-connections.mjs --server=http://127.0.0.1:8080",
    "audit:render": "node scripts/audit-render.mjs",
    "audit:live": "node scripts/audit-live.mjs",
    "audit:live:server": "node scripts/audit-live.mjs --server=http://127.0.0.1:8080",
    "audit:contracts": "node scripts/audit-contracts.mjs",
    "audit:all": "pnpm run audit:contracts && pnpm run audit:connections:live && pnpm run audit:live && pnpm run audit:brain:linked && pnpm run audit:twins && pnpm run ops:selftest",
    "audit:brain": "node scripts/audit-static-brain.mjs",
    "audit:brain:linked": "node scripts/audit-static-brain.mjs --server=http://127.0.0.1:8080",
    "typecheck:ratchet": "node scripts/typecheck-ratchet.mjs",
    "typecheck:ratchet:update": "node scripts/typecheck-ratchet.mjs --update",
    "ops:selftest": "node scripts/ops-selftest.mjs",
    "gates": "node scripts/agent-gates.mjs",
    "gates:fast": "node scripts/agent-gates.mjs --fast",
    "audit:twins": "node scripts/audit-twins.mjs",
    "audit:bundle": "node scripts/audit-bundle-secrets.mjs"
  },
  "private": true,
  "devDependencies": {
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr@<2.0.8": ">=2.0.8",
      "body-parser@<2.4.0": ">=2.4.0",
      "form-data@<4.0.6": ">=4.0.6",
      "qs@<6.16.1": ">=6.16.1",
      "markdown-it@<14.3.3": ">=14.3.3",
      "nanoid@<3.3.18": ">=3.3.18",
      "js-yaml@<4.3.2": ">=4.3.2",
      "source-map-js@<1.2.2": ">=1.2.2",
      "postcss-selector-parser@<6.1.5": ">=6.1.5",
      "fast-copy@<4.1.0": ">=4.1.0",
      "fast-uri@<3.1.9": ">=3.1.9",
      "browserslist@<4.28.7": ">=4.28.7",
      "baseline-browser-mapping@<2.11.0": ">=2.11.0",
      "@babel/core@<7.29.6": ">=7.29.6",
      "brace-expansion@>=5.0.0 <5.0.12": ">=5.0.12",
      "@esbuild-kit/core-utils>esbuild": ">=0.25.0",
      "postcss@<8.5.23": ">=8.5.23",
      "esbuild": "0.28.1"
    }
  }
}
