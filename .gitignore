# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# ── NOVA long-term memory (personal runtime data, never committed) ───────────
nova-memory.json
nova-memory.json.*
nova-memory-*.json
*cybernova-nova-memory*

# api-server runtime logs (never content)
artifacts/api-server/logs/

# fleet mesh runtime state
fleet-mesh.json

# portable 24/7 bundle output (built by CI, published as a release asset)
dist-standalone/

# fleet-node kit output (published as a release asset by CI)
dist-node-kit/

# ── Ops: authorized-target registry + durable job state (runtime, personal) ──
state/programs.json
state/jobs/
state/jobs/*
# the findings vault is engine runtime state too — it is rebuilt by POST /api/ops/findings/sync
state/findings-vault.json
# self-update watcher chatter (written next to the engine's cwd)
state/auto-update.json
state/auto-update.log
# static binaries fetched by scripts/fetch-toolchain.mjs at build time
/vendor/
state/vuln-corpus/
