# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# ── NOVA long-term memory (personal runtime data, never committed) ───────────
nova-memory.json
nova-memory.json.*
nova-memory-*.json
*cybernova-nova-memory*

# api-server runtime logs (never content)
artifacts/api-server/logs/

# fleet mesh runtime state
fleet-mesh.json

# portable 24/7 bundle output (built by CI, published as a release asset)
dist-standalone/

# fleet-node kit output (published as a release asset by CI)
dist-node-kit/

# ── Ops: authorized-target registry + durable job state (runtime, personal) ──
state/programs.json
state/jobs/
state/jobs/*
# ── Runtime state that leaks infrastructure (added 2026-11-05) ──────────────
# These files are written by the running engine and contain live host/port,
# backend URLs and connector proofs. They are runtime output, not source, and
# must never be committed. The files stay on disk; only tracking is stopped.
state/backend-health.json
state/connectors.json
state/free-hosts.json
state/free-hosts.md
state/hunt-latest.json
state/hunt-runs.csv
state/hunt-findings.csv
state/hunt/
state/discovered-vulnerabilities-vault.json
state/cybernova-brain-state.json
state/advisory-cache.json
state/advisory-last-failure.json
state/corpus-last-failure.json
state/cryptocom-hackerone-scope.json
# machine bootstrap notes carry the live host:port and slot id
deploy/machines/STATE-*.md
deploy/machines/waifly-live.md
deploy/machines/form-answers.md
# engine probe output (host/port + banner)
probe-report.txt
# the findings vault is engine runtime state too — it is rebuilt by POST /api/ops/findings/sync
state/findings-vault.json
state/fleet-servers.json
# self-update watcher chatter (written next to the engine's cwd)
state/auto-update.json
state/auto-update.log
# static binaries fetched by scripts/fetch-toolchain.mjs at build time
/vendor/
state/vuln-corpus/

# secrets live here, never in git
.env
.env.*
!.env.example

# the machine bootstrap writes this; it holds NOVA_EXEC_TOKEN
.env.local
# بايتات بايثون بتتولد من سكريبتات deploy/
__pycache__/
*.pyc

# ملفات توليد القرايات المؤقتة (scripts/build-freelists.mjs بدون --repo)
/artifacts/freelists/
