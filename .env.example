# ─────────────────────────────────────────────────────────────────────────────
# NOVA / CyberNova — environment template
# Copy to `.env` and fill in. NEVER commit `.env` (it is git-ignored).
# Added 2026-11-05. No secret is baked into the source; everything is read here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend (Supabase Edge + Postgres) ───────────────────────────────────────
# The publishable/anon key is safe in a browser bundle; the service key is NOT.
NOVA_SUPABASE_URL=https://<project-ref>.supabase.co
NOVA_SUPABASE_SERVICE_KEY=            # server-side only — never ship to the browser
NOVA_BACKEND=https://<project-ref>.supabase.co/functions/v1/ops-api

# ── Fleet / hub ──────────────────────────────────────────────────────────────
# Token the hub requires before it will register a node. Generate a long random
# string; the same value goes into GitHub Secrets as NOVA_EXEC_TOKEN.
NOVA_EXEC_TOKEN=
NOVA_HUB=wss://nova.waifly.com/api/local-agent/ws
FLEET_ENABLED=0                       # set to 1 to let the fleet wave run

# ── Ops gate (NOVA_EXEC_TOKEN) ───────────────────────────────────────────────
# NOVA_EXEC_TOKEN is the single key that unlocks every powerful surface: the
# chat brain, the fleet bus, the tool catalogue, the device inventory, the event
# bus, terminal/exec, the kill-switch and the installer. Generate it once with:
#
#     openssl rand -hex 32
#
# then set the SAME value in three places:
#   1. the server's environment (this file / the host's env),
#   2. GitHub Secrets as NOVA_EXEC_TOKEN (so CI and the fleet nodes agree),
#   3. the panel: paste it into the token field in the ops room (it is stored in
#      localStorage as `cybernova_ops_token` and sent as the `x-nova-token`
#      header, or `?token=` on transports that cannot set headers).
#
# With it unset, the engine falls back to same-origin-only for writes and keeps
# sensitive reads (tools/persona/version, device inventory, event bus) behind
# the same-origin wall — a speed bump, NOT authentication. On any public host,
# set it. NOVA_OPEN_OPS=1 is a loud, local-lab-only opt-out; never use it online.
NOVA_OPEN_OPS=0

# ── Free AI providers (all OpenAI-compatible, no card) ───────────────────────
# Any subset works; the multi-router falls back across whichever are present.
GROQ_API_KEY=                         # console.groq.com  — fastest
OPENROUTER_API_KEY=                   # openrouter.ai     — 20+ free models
GEMINI_API_KEY=                       # aistudio.google.com — generous quota
MISTRAL_API_KEY=                      # console.mistral.ai
HUGGINGFACE_API_KEY=                  # huggingface.co
TOGETHER_API_KEY=                     # together.ai
NVIDIA_API_KEY=                       # build.nvidia.com  — nvapi-…

# ── Local model (optional) ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Safety switches ──────────────────────────────────────────────────────────
# Source download is OFF unless explicitly enabled (it used to leak .env).
NOVA_ALLOW_SOURCE_DOWNLOAD=0

# ══════════════════════════════════════════════════════════════════════════════
# المتغيّرات التالية كانت **مستخدمة في الكود** لكنها **غير موثّقة** هنا.
# أُضيفت 2026-11-05 كقوالب فارغة فقط — مفيش أي قيمة سرّية مكتوبة.
# كل واحد منها اختياري إلا لو معلّم بـ (مطلوب).
# ══════════════════════════════════════════════════════════════════════════════

# ── قاعدة البيانات (مطلوب للتشغيل الكامل مع Postgres) ────────────────────────
DATABASE_URL=                         # postgres://user:pass@host:5432/db

# ── مزوّدو AI إضافيون (كلهم اختياريون — الـ router بيتخطّى اللي مش موجود) ─────
ANTHROPIC_API_KEY=                    # console.anthropic.com
OPENAI_API_KEY=                       # مدفوع — آخر خيار في السلسلة
CEREBRAS_API_KEY=                     # cloud.cerebras.ai — طبقة مجانية سريعة
GITHUB_MODELS_TOKEN=                  # أي توكن GitHub — GitHub Models مجاني
CLOUDFLARE_ACCOUNT_ID=                # Workers AI — يحتاج كمان CLOUDFLARE_API_TOKEN
CLOUDFLARE_API_TOKEN=
NVIDIA_API_KEY=                       # build.nvidia.com — nvapi-…

# ── أسماء الموديلات (تجاوز اختياري لكل مزوّد) ────────────────────────────────
GROQ_MODEL=
OPENROUTER_MODEL=
GEMINI_MODEL=
MISTRAL_MODEL=
TOGETHER_MODEL=
CEREBRAS_MODEL=
GITHUB_MODELS_MODEL=
OPENAI_MODEL=
OLLAMA_MODEL=
OLLAMA_PULL_TIMEOUT_MS=

# ── مزوّدو "بدون مفتاح" (keyless) — شغّالين افتراضيًا بدون أي حساب ───────────
NOVA_KEYLESS_LLM=1                    # 0 = اقفل كل الـ keyless
NOVA_EXTRA_KEYLESS=1                  # 0 = اقفل LLM7 + OVH بس
NOVA_KEYLESS_SEATS=openai-fast,mistral,llama
POLLINATIONS_BASE_URL=https://text.pollinations.ai/openai
POLLINATIONS_MODEL=
LLM7_BASE_URL=https://api.llm7.io/v1
LLM7_MODEL=gpt-oss:20b
OVH_AI_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
OVH_AI_MODEL=Qwen3.6-27B

# ── الأسطول (Fleet) ──────────────────────────────────────────────────────────
NOVA_HUB_URL=wss://nova.waifly.com/api/local-agent/ws
NOVA_FLEET_MACHINES=5                 # الهدف المعلن في /api/fleet/mesh
NOVA_FLEET_AGENTS=10
NOVA_FLEET_SEED=
NOVA_AGENT_ID=
NOVA_SERVER=
NOVA_ROLE=
NOVA_SERVERS_FILE=
NOVA_MESH_FILE=
NOVA_EXTRA_PORTS=
NOVA_HOST_PROBE_TTL_MS=
NOVA_AWARENESS_TTL_MS=
NOVA_AWARENESS_NET_TTL_MS=

# ── بوابة التصريح / النطاق (scope gate) ──────────────────────────────────────
NOVA_OPEN_OPS=0                       # 1 = يفتح الكتابة للجميع (خطر — للتطوير المحلي فقط)
NOVA_SCOPE_DOMAINS=
NOVA_PROGRAMS_FILE=
NOVA_PROGRAMS_REL=
NOVA_BOUNTY_CATALOG=
NOVA_DEFAULT_RPS=2
NOVA_MAX_INFLIGHT=
NOVA_RUNNER_ALLOW_ACTIVE=0            # 1 = يسمح بالفحص النشط من الـ runner
NOVA_OPS_AUTONOMY=passive             # passive | assisted | active
NOVA_FORCE_LOCAL_TOOLS=0
NOVA_ALLOW_NODE_TOOLS=1
NOVA_EXEC_ALLOW_SHELL=0               # 1 = يسمح بتنفيذ shell من /api/exec
ENABLE_AGENT_SHELL=0                  # 1 = يسمح لأدوات الوكيل بتنفيذ shell

# ── سلسلة الأدوات (Kali / ProjectDiscovery) ──────────────────────────────────
NOVA_TOOLCHAIN_FETCH=                 # 1 أو auto = ينزّل الأدوات وقت الإقلاع
NOVA_TOOLCHAIN_RECORD=
NOVA_TOOLCHAIN_RETRY_MS=
NOVA_TOOL_DIR=
NOVA_VENDOR_BIN=
NOVA_NUCLEI_PROFILE=

# ── كوربوس الثغرات والمصادر الحقيقية ─────────────────────────────────────────
NOVA_CORPUS_URL=
NOVA_CORPUS_DIR=
NOVA_CORPUS_FILE=
NOVA_CORPUS_INDEX=
NOVA_CORPUS_INDEX_REL=
NOVA_CORPUS_REL=
NOVA_CORPUS_AUTODOWNLOAD=1
NOVA_ADVISORY_CACHE=
NOVA_ADVISORY_REL=
NOVA_ADVISORY_MIN_SEVERITY=
NVD_API_KEY=                          # nvd.nist.gov — يرفع حد الطلبات من 5 لـ 50/30ث

# ── الذاكرة والأدلة ──────────────────────────────────────────────────────────
NOVA_MEMORY_FILE=
NOVA_MEMORY_MAX=
NOVA_MEMORY_ROW=
NOVA_FINDINGS_VAULT=
NOVA_JOBS_REL=
NOVA_VERIFY_FILE=
NOVA_VERIFY_MAX_AGE_H=
