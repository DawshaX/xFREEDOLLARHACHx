# ── NOVA agent — brain configuration (all options are 100% free) ─────────────
# Copy to .env and uncomment what you actually run.

# 1) Local Ollama (default, private, unlimited)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# 2) Free-tier cloud fallbacks (only used when Ollama is offline)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=

# 3) Opt-in shell tool (disabled by default — the agent cannot run shell until you set this)
# ENABLE_AGENT_SHELL=1

# 4) Server
PORT=8080
